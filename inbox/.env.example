# Vercel 프로젝트 설정 → Environment Variables 에 넣는다.
# ★ 넣은 뒤 반드시 재배포해야 적용된다.
# ★ 계명 7 — 이 값들은 절대 코드나 저장소에 커밋하지 않는다. 노출됐으면 BotFather /revoke.

# ── 필수 ──────────────────────────────────────────────
BOT_TOKEN=            # BotFather 가 준 토큰 (1234567890:AA...)
MY_CHAT_ID=           # 내 chat_id (숫자). 이 사람 말만 받는다.
TG_WEBHOOK_SECRET=    # 아무 긴 임의 문자열. setWebhook 의 secret_token 과 같아야 한다.

# ── 노션 미러 (이 구성에서는 사실상 필수) ─────────────
NOTION_TOKEN=         # notion.so/my-integrations 에서 만든 integration 토큰
NOTION_DB=            # DB URL 의 32자리 database_id

# ── 회수(읽기) API ────────────────────────────────────
INBOX_READ_KEY=       # 비워두면 /api/inbox 는 열리지 않는다 (안전 기본값)

# ── 선택: 장부 읽기 최적화 ────────────────────────────
# 넣으면 Blob "고급 작업" 호출이 0회가 된다.
# 계명 9 — 고급 작업은 무료 플랜 월 2,000회이고, 넘기면 계정 저장소 전체가 차단된다.
# 값: Vercel Blob 스토어의 공개 베이스 URL (예: https://xxxxxxxx.public.blob.vercel-storage.com)
BLOB_BASE_URL=
